RewriteEngine On
RewriteBase /dashboard/

# Redirect /dashboard/index.php → /dashboard/index
RewriteCond %{THE_REQUEST} \s/dashboard/([^\s]+)\.php[\s?] [NC]
RewriteCond %{DOCUMENT_ROOT}/dashboard/%1.php -f
RewriteRule ^ %1 [R=301,L]

# Internally rewrite /dashboard/index → /dashboard/index.php
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\s/]+)$ $1.php [L]
